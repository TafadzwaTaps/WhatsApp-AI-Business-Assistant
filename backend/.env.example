# WaziBot backend — environment variables
# Copy to .env for local dev, or set these in Render → Environment.
# NEVER put real values in this file — it is tracked in git.

# ── Core / Database ──────────────────────────────────────────────────────────
# Leave DATABASE_URL unset locally to use SQLite (./app.db) automatically.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=generate-a-long-random-secret
SUPABASE_ANON_KEY=generate-a-long-random-secret

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required in production. If unset, the app generates a random one at boot
# (every restart invalidates all sessions) rather than silently using a
# known default — see core/auth.py. Must be a long, random string.
SECRET_KEY=generate-a-long-random-secret
# Superadmin login is DISABLED until this is a real, non-default password.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
# Required — app refuses to start without it (encrypts WhatsApp tokens at rest).
FERNET_KEY=generate-with-python-c-import-fernet-fernet-fernet-generate-key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of extra allowed origins (wazibothq.com + localhost
# are allowed by default — see main.py).
ALLOWED_ORIGINS=

# ── WhatsApp Cloud API ──────────────────────────────────────────────────────
VERIFY_TOKEN=choose-your-own-webhook-verify-string
# Required for webhook signature verification — without this, incoming
# WhatsApp webhook requests are NOT authenticated. See
# services/security.py::verify_meta_signature.
WHATSAPP_APP_SECRET=
SHARED_WA_TOKEN=
SHARED_PHONE_NUMBER_ID=
SHARED_WA_PHONE=
SHARED_WHATSAPP_NUMBER=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
PAYPAL_WEBHOOK_ID=

# ── AI providers ──────────────────────────────────────────────────────────────
# Either (or both) enables AI replies, image understanding, and the
# upload content-moderation vision check.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@wazibothq.com
EMAIL_MAILING_ADDRESS=

# ── Cron / scheduled jobs ─────────────────────────────────────────────────────
# Shared secret the scheduled job sends as `x-cron-secret`. Cron endpoints
# fail closed (503) if this is unset.
CRON_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────────
SENTRY_DSN=
WAZIBOT_URL=https://wazibothq.com
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_JSON=
