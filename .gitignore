# Secrets / environment — NEVER commit real credentials.
# This repo currently has no .gitignore at all, which means a future
# `git add .` would be free to stage a real .env file or the local .venv/
# by accident. Nothing here removes anything already tracked.
.env
.env.*
!.env.example

# Private keys / credential files
*.pem
*.key
credentials.json
service-account.json
secrets.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.sqlite3
app.db

# Node (static/ tooling, if any gets added later)
node_modules/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
